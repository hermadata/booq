function pfRenderTren(tren) {
  const wadah = el('pf-tren');
  if (!wadah) return;
  if (!tren.length || !tren.some(t => t.pemasukan || t.pengeluaran || t.kekayaan)) { wadah.innerHTML = '<div class="fin2-kosong">Belum cukup data untuk grafik.</div>'; return; }
  const W = 520, H = 220, pl = 8, pr = 8, pt = 34, pb = 30;
  const maks = Math.max(1, ...tren.map(t => Math.max(t.pemasukan, t.pengeluaran, 0)));
  const y = v => pt + (maks - v) / maks * (H - pt - pb);
  const lebarGrup = (W - pl - pr) / tren.length, lb = Math.min(20, lebarGrup / 3.4);
  // Garis kekayaan bersih: skala sendiri di pita atas grafik
  const kv = tren.map(t => t.kekayaan), kMin = Math.min(...kv), kMax = Math.max(...kv), kR = (kMax - kMin) || 1;
  const yk = v => 14 + (kMax - v) / kR * (H - pt - pb) * 0.55;
  let svg = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Grafik pemasukan, pengeluaran dan kekayaan bersih 6 bulan">`;
  svg += `<line x1="${pl}" x2="${W - pr}" y1="${y(0)}" y2="${y(0)}" stroke="var(--web-border)" stroke-width="1"/>`;
  let titik = '';
  tren.forEach((t, i) => {
    const cx = pl + lebarGrup * i + lebarGrup / 2;
    const ym = y(Math.max(0, t.pemasukan)), yo = y(Math.max(0, t.pengeluaran)), y0 = y(0);
    svg += `<rect x="${cx - lb - 2}" y="${ym}" width="${lb}" height="${Math.max(1, y0 - ym)}" rx="5" fill="var(--fin-aksen-garis)"><title>${t.bulan} · Pemasukan ${fin2Rp(t.pemasukan)}</title></rect>`;
    svg += `<rect x="${cx + 2}" y="${yo}" width="${lb}" height="${Math.max(1, y0 - yo)}" rx="5" fill="#f59e0b" opacity="0.85"><title>${t.bulan} · Pengeluaran ${fin2Rp(t.pengeluaran)}</title></rect>`;
    svg += `<text x="${cx}" y="${H - 10}" text-anchor="middle" font-size="11" fill="var(--fin-slate-5)">${escapeHtml(t.bulan)}</text>`;
    titik += (i ? ' L' : 'M') + cx.toFixed(1) + ' ' + yk(t.kekayaan).toFixed(1);
  });
  svg += `<path d="${titik}" fill="none" stroke="var(--fin-aksen)" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>`;
  tren.forEach((t, i) => {
    const cx = pl + lebarGrup * i + lebarGrup / 2, yy = yk(t.kekayaan);
    svg += `<circle cx="${cx}" cy="${yy}" r="3.6" fill="var(--fin-kartu)" stroke="var(--fin-aksen)" stroke-width="2"><title>${t.bulan} · Kekayaan bersih ${fin2Rp(t.kekayaan)}</title></circle>`;
    if (i === tren.length - 1 || i === 0) svg += `<text x="${cx}" y="${yy - 8}" text-anchor="${i === 0 ? 'start' : 'end'}" font-size="9.5" font-weight="600" fill="var(--fin-aksen-teks)">${fin2RpSingkat(t.kekayaan)}</text>`;
  });
  wadah.innerHTML = svg + '</svg>';
}

