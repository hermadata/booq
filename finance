      h += `<tr class="${i === 0 ? 'awal' : ''}">${i === 0 ? `<td rowspan="${n + 1}" class="tgl">${escapeHtml(fin2TglPendek(e.t))}</td><td rowspan="${n + 1}" class="kode">${escapeHtml(e.no)}</td>` : ''}
        <td class="${x[3] ? 'kr' : ''}"><button type="button" class="fin2-link fin2-akun-link" onclick="pfBukaBukuBesar('${pgrAttr(x[0])}')">${escapeHtml(x[0])}</button> ${escapeHtml(x[1])}</td>
        <td class="n">${x[2] ? fin2Ang(x[2]) : ''}</td><td class="n">${x[3] ? fin2Ang(x[3]) : ''}</td></tr>`;
    });
    h += `<tr class="ket"><td colspan="3">${escapeHtml(e.ket)}</td></tr>`;
  });
  h += '</tbody></table></div>' + pfPagerHtml(d, 'pfJrHal');
  h += `<div class="fin2-lap-catatan">Setiap baris jurnal tersimpan di sheet <b>Jurnal</b> spreadsheet Anda. Debet ditulis lebih dulu, kredit menjorok ke kanan.</div>`;
