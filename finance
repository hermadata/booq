function pfBbFilter() { pf.bb.akun = el('pf-bb-akun').value; pf.bb.cari = el('pf-bb-cari').value.trim(); pf.bb.hal = 1; pfRenderLaporan(); }
function pfHtmlJurnal(L) {
  const st = pf.jr, d = st.data, jenis = (L && L.jenisJurnal) || {};
