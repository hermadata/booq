    td small{display:block;font-size:10px;color:#64748b}tfoot td{border-top:2px solid #1e293b;font-weight:700}tr.saldo td{background:#f8fafc;font-weight:600}tr.ket td{font-style:italic;color:#64748b;font-size:10.5px;border-bottom:1px solid #e2e8f0}
    td.kr{padding-left:34px}.fin2-lap-catatan{max-width:760px;margin:14px auto 0;font-size:10.5px;color:#64748b;line-height:1.6}.fin2-cek{font-weight:700}
    .fin2-jr-alat,.fin2-pager,button.fin2-link:not(.fin2-akun-link){display:none}button{border:none;background:none;font:inherit;color:inherit;padding:0}
    .fin2-bb-ringkas{display:flex;gap:10px;max-width:760px;margin:0 auto 12px}.fin2-bb-ringkas div{flex:1;border:1px solid #e2e8f0;border-radius:8px;padding:6px 8px;font-size:10.5px}.fin2-bb-ringkas b{display:block;font-size:12px}
    .pf-rasio{display:flex;gap:10px;max-width:760px;margin:16px auto 0}.pf-rasio div{flex:1;border:1px solid #e2e8f0;border-radius:8px;padding:6px 8px;font-size:10.5px}.pf-rasio b,.pf-rasio span,.pf-rasio small{display:block}
    .fin2-jr-info{max-width:760px;margin:0 auto 8px;font-size:10.5px;color:#64748b}`;
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Laporan Keuangan Pribadi ${escapeHtml(pf.lap.periode.dari)} sd ${escapeHtml(pf.lap.periode.sampai)}</title><style>${gaya}</style></head><body>${wadah.innerHTML}<script>window.onload=function(){setTimeout(function(){window.print();},300);};<\/script></body></html>`);
  w.document.close();
}
async function pfExportCsv(btn) {
  btn.disabled = true;
  try {
    const d = await api({ aksi: 'export', dari: pf.dari, sampai: pf.sampai });
    const sel = v => { const s = String(v === null || v === undefined ? '' : v); return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
    const csv = '\uFEFF' + [d.kolom].concat(d.baris).map(r => r.map(sel).join(';')).join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    a.download = 'Jurnal_Keuangan_Pribadi_' + d.periode.dari + '_sd_' + d.periode.sampai + '.csv';
    document.body.appendChild(a); a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1500);
    pgrToast('✓ ' + d.baris.length + ' baris jurnal diekspor');
  } catch (err) { pgrToast('✗ ' + err.message); }
  finally { btn.disabled = false; }
}

/* =====================================================================================
   5. PENGATURAN (Saldo awal · Daftar akun · Aturan otomatis · Profil)
   ===================================================================================== */
function pfRenderSetelan() {
  // Saldo awal
  el('pf-sa-tanggal').value = pf.setelan.tanggalMulai || krTgl(new Date(new Date().getFullYear(), new Date().getMonth(), 1));
  el('pf-sa-isi').innerHTML = PF_NERACA.map(g => {
    const list = pf.akun.filter(a => a.gol === g && (a.aktif || pf.saldoAwal[a.kode]));
    if (!list.length) return '';
    return `<div class="pf-sa-grup"><b>${escapeHtml(pfLabelGol(g))}</b>` + list.map(a => `<div class="pf-sa-baris"><span>${escapeHtml((a.ikon ? a.ikon + ' ' : '') + a.nama)}</span>
      <div class="fin2-rp-wrap kecil"><span>Rp</span><input type="text" inputmode="numeric" data-sa="${a.kode}" data-sisi="${g.indexOf('utang') === 0 ? 'utang' : 'aset'}" value="${pf.saldoAwal[a.kode] ? Math.round(pf.saldoAwal[a.kode]).toLocaleString('id-ID') : ''}" placeholder="0" oninput="fin2FormatInputRp(this, true); pfSaHitung()" aria-label="Saldo awal ${escapeHtml(a.nama)}" /></div></div>`).join('') + '</div>';
  }).join('');
  pfSaHitung();
  // Akun
  el('pf-akun-gol').innerHTML = `<optgroup label="Aset"><option value="kas">Aset lancar (rekening, e-wallet, tunai)</option><option value="piutang">Piutang (uang dipinjamkan)</option><option value="investasi">Investasi (reksadana, saham, emas, kripto…)</option><option value="tetap">Aset tetap (kendaraan, properti)</option></optgroup>
    <optgroup label="Utang"><option value="utangPendek">Utang jangka pendek (kartu kredit, paylater)</option><option value="utangPanjang">Utang jangka panjang (KPR, kredit kendaraan)</option></optgroup>
    <optgroup label="Pemasukan"><option value="pendapatan">Pemasukan</option></optgroup>
    <optgroup label="Pengeluaran">${pf.grupBeban.map(g => `<option value="beban:${g.k}">Pengeluaran · ${escapeHtml(g.label)}</option>`).join('')}</optgroup>`;
  pfRenderDaftarAkun();
  // Aturan
  el('pf-at-kode').innerHTML = pfOpsiAkun(PF_GOL_KATEGORI, '5-101');
  pfRenderAturan('');
  el('pf-set-nama').value = pf.setelan.nama || '';
  pfTerapkanTema();
}
function pfSaHitung() {
  let aset = 0, utang = 0;
  document.querySelectorAll('[data-sa]').forEach(i => { const v = fin2AngkaDariInput(i); if (i.dataset.sisi === 'utang') utang += v; else aset += v; });
  el('pf-sa-aset').textContent = fin2Rp(aset);
  el('pf-sa-utang').textContent = fin2Rp(utang);
  el('pf-sa-bersih').textContent = fin2Rp(aset - utang);
}
async function pfSimpanSaldoAwal(btn) {
  const saldo = {};
  document.querySelectorAll('[data-sa]').forEach(i => { const v = fin2AngkaDariInput(i); if (v) saldo[i.dataset.sa] = v; });
  const tanggal = el('pf-sa-tanggal').value, st = el('pf-sa-status');
  if (!tanggal) { st.className = 'status-text err'; st.textContent = 'Isi tanggal mulai.'; return; }
  btn.disabled = true; btn.textContent = 'Menyimpan…';
  try {
    const r = await api({ aksi: 'simpan_saldo_awal', tanggal, saldo });
    st.className = 'status-text ok'; st.textContent = '✓ Saldo awal tersimpan · kekayaan bersih awal ' + fin2Rp(r.kekayaanAwal);
    pf.setelan.tanggalMulai = tanggal; pf.saldoAwal = saldo;
    try { localStorage.setItem('pf_setelan', JSON.stringify({ tanggalMulai: tanggal })); } catch (e) { }
    try { localStorage.removeItem(PF_SNAP); } catch (e) { }
    pgrToast('✓ Saldo awal tersimpan');
    pfMuatUlangSemua(false);
  } catch (err) { st.className = 'status-text err'; st.textContent = '✗ ' + err.message; }
  finally { btn.disabled = false; btn.textContent = 'Simpan Saldo Awal'; }
}
function pfRenderDaftarAkun() {
  const urut = ['kas', 'piutang', 'investasi', 'tetap', 'utangPendek', 'utangPanjang', 'pendapatan', 'beban'];
  el('pf-akun-daftar').innerHTML = urut.map(g => {
    const list = pf.akun.filter(a => a.gol === g);
    if (!list.length) return '';
    const isi = g === 'beban'
      ? pf.grupBeban.map(gr => { const l = list.filter(a => a.grup === gr.k); return l.length ? `<div class="fin2-ctt-kecil" style="margin:8px 0 2px;">${escapeHtml(gr.label)}</div>` + l.map(pfAkunBarisHtml).join('') : ''; }).join('')
      : list.map(pfAkunBarisHtml).join('');
    return `<details class="pf-sa-grup" ${g === 'kas' ? 'open' : ''}><summary style="cursor:pointer;"><b style="display:inline;">${escapeHtml(pfLabelGol(g))}</b> <span class="fin2-ctt-kecil" style="display:inline;">(${list.length})</span></summary><div class="pf-akun-daftar">${isi}</div></details>`;
  }).join('');
}
function pfAkunBarisHtml(a) {
  return `<div class="pf-akun-baris ${a.aktif ? '' : 'mati'}"><span>${escapeHtml(a.ikon || '·')}</span><span class="pf-akun-nama">${escapeHtml(a.nama)} <span class="kode">${a.kode}</span></span>
    <button type="button" onclick="pfUbahAkun('${a.kode}', 'nama')" title="Ganti nama">✎</button>
    <button type="button" onclick="pfUbahAkun('${a.kode}', 'aktif')">${a.aktif ? 'Sembunyikan' : 'Aktifkan'}</button></div>`;
}
async function pfUbahAkun(kode, apa) {
  const a = pf.A[kode];
  if (!a) return;
  const body = { aksi: 'ubah_akun', kode };
  if (apa === 'nama') {
    const nama = prompt('Nama baru untuk akun ' + a.nama + ':', a.nama);
    if (!nama || nama.trim() === a.nama) return;
    body.nama = nama.trim();
    const ikon = prompt('Ikon (emoji) - kosongkan kalau tidak diubah:', a.ikon || '');
    if (ikon !== null && ikon !== a.ikon) body.ikon = ikon.trim();
  } else body.aktif = !a.aktif;
  try {
    const r = await api(body);
    pfSetAkun(r.akun);
    pfRenderDaftarAkun();
    pgrToast('✓ Akun diperbarui');
    try { localStorage.removeItem(PF_SNAP); } catch (e) { }
  } catch (err) { pgrToast('✗ ' + err.message); }
}
async function pfTambahAkun(btn) {
  const nama = el('pf-akun-nama').value.trim(), golV = el('pf-akun-gol').value, st = el('pf-akun-status');
  const [gol, grup] = golV.split(':');
  if (nama.length < 2) { st.className = 'status-text err'; st.textContent = 'Isi nama akun.'; el('pf-akun-nama').focus(); return; }
  btn.disabled = true;
  try {
    const r = await api({ aksi: 'tambah_akun', nama, gol, grup: grup || '', ikon: el('pf-akun-ikon').value.trim() });
    pfSetAkun(r.akun);
    st.className = 'status-text ok'; st.textContent = '✓ Akun "' + nama + '" ditambahkan (kode ' + r.kode + ')';
    el('pf-akun-nama').value = ''; el('pf-akun-ikon').value = '';
    try { localStorage.removeItem(PF_SNAP); } catch (e) { }
    pfRenderSetelan();
  } catch (err) { st.className = 'status-text err'; st.textContent = '✗ ' + err.message; }
  finally { btn.disabled = false; }
}
function pfRenderAturan(cari) {
  const q = String(cari || '').trim().toUpperCase();
  const list = pf.aturan.filter(r => !q || r.kata.includes(q) || pfNamaAkun(r.kode).toUpperCase().includes(q))
    .sort((a, b) => pfNamaAkun(a.kode).localeCompare(pfNamaAkun(b.kode)) || a.kata.localeCompare(b.kata));
  el('pf-at-daftar').innerHTML = `<table class="fin2-tbl"><thead><tr><th>Kata kunci</th><th>Arah</th><th>Masuk ke akun</th><th></th></tr></thead><tbody>` +
    (list.length ? list.map(r => `<tr><td><b>${escapeHtml(r.kata)}</b></td><td><span class="pf-chip-arah ${r.arah}">${r.arah === 'masuk' ? '↓ masuk' : r.arah === 'keluar' ? '↑ keluar' : '↕ keduanya'}</span></td>
      <td>${escapeHtml(pfIkon(r.kode) + ' ' + pfNamaAkun(r.kode))}</td>
      <td class="n"><button type="button" class="pf-hapus-baris" title="Hapus aturan" onclick="pfHapusAturan('${pgrAttr(r.kata)}', '${r.arah}', this)">🗑</button></td></tr>`).join('')
      : '<tr><td colspan="4" class="fin2-kosong">Tidak ada aturan.</td></tr>') + '</tbody></table>';
}
async function pfSimpanAturan(btn) {
  const kata = el('pf-at-kata').value.trim(), arah = el('pf-at-arah').value, kode = el('pf-at-kode').value;
  if (kata.length < 3) { pgrToast('Kata kunci minimal 3 huruf'); el('pf-at-kata').focus(); return; }
  btn.disabled = true;
  try {
    const r = await api({ aksi: 'simpan_aturan', kata, arah, kode, terapkan: true });
    pf.aturan = r.aturan;
    el('pf-at-kata').value = '';
    pfRenderAturan('');
    pgrToast(`✓ Aturan disimpan` + (r.diubah ? ` · ${r.diubah} transaksi lama ikut dikategorikan` : ''));
    if (r.diubah) pfSetelahTulis();
  } catch (err) { pgrToast('✗ ' + err.message); }
  finally { btn.disabled = false; }
}
async function pfHapusAturan(kata, arah, btn) {
  btn.disabled = true;
  try {
    const r = await api({ aksi: 'hapus_aturan', kata, arah });
    pf.aturan = r.aturan; pfRenderAturan('');
    pgrToast('✓ Aturan "' + kata + '" dihapus');
  } catch (err) { pgrToast('✗ ' + err.message); btn.disabled = false; }
}
async function pfSimpanNama(btn) {
  btn.disabled = true;
  try {
    const nama = el('pf-set-nama').value.trim();
    await api({ aksi: 'simpan_setelan', nama });
    pf.setelan.nama = nama;
    el('pf-nama-sidebar').textContent = nama || 'Keuangan Pribadi';
    el('pf-eyebrow').textContent = nama ? 'Keuangan Pribadi · ' + nama : 'Keuangan Pribadi';
    pgrToast('✓ Nama disimpan');
  } catch (err) { pgrToast('✗ ' + err.message); }
  finally { btn.disabled = false; }
}

/* ---------- Mulai ---------- */
document.addEventListener('click', e => { const m = el('pf-user-menu'); if (m && !m.contains(e.target)) m.classList.remove('web-user-menu-open'); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.fmk-modal').forEach(m => { m.hidden = true; }); });
window.addEventListener('hashchange', () => {
  const h = (location.hash || '').replace('#', '').split('/');
  if (PF_JUDUL[h[0]] && (h[0] !== pf.view || (h[0] === 'laporan' && h[1] && h[1] !== pf.tabLap))) pfBuka(h[0], h[1]);
});
pfBoot();
</script>
