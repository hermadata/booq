/* ---------- Smart Paste struk / invoice / notifikasi (form Catat) - parser sp* OmniAI ---------- */
function spAngka(s) { return Math.round(fmkAngka_(String(s || '').replace(/^\s*-?\s*Rp\.?/i, m => /-/.test(m) ? '-' : '')).n); }
function spBaris(teks) { return String(teks || '').split(/\r?\n/).map(s => s.replace(/\u00a0/g, ' ').trim()).filter(Boolean); }
const SP_BULAN = { januari: 0, jan: 0, februari: 1, feb: 1, maret: 2, mar: 2, april: 3, apr: 3, mei: 4, may: 4, juni: 5, jun: 5, juli: 6, jul: 6, agustus: 7, agu: 7, agt: 7, aug: 7, september: 8, sep: 8, sept: 8, oktober: 9, okt: 9, oct: 9, november: 10, nov: 10, nop: 10, desember: 11, des: 11, dec: 11 };
function spTanggal(teks) {
  const t = String(teks || '');
  let m = t.match(/(\d{1,2})\s+([A-Za-z]{3,9})\.?\s+(\d{4})(?:[\s,]+(?:pukul\s+)?(\d{1,2})[:.](\d{2}))?/);
  if (m && SP_BULAN[m[2].toLowerCase()] !== undefined) return { tanggal: new Date(+m[3], SP_BULAN[m[2].toLowerCase()], +m[1], 12), adaJam: !!m[4] };
  m = t.match(/(\d{1,2})[-/](\d{1,2})[-/](\d{4})(?:\s+(\d{1,2}):(\d{2}))?/);
  if (m) return { tanggal: new Date(+m[3], +m[2] - 1, +m[1], 12), adaJam: !!m[4] };
  m = t.match(/(\d{4})-(\d{2})-(\d{2})(?:[ T](\d{1,2}):(\d{2}))?/);
  if (m) return { tanggal: new Date(+m[1], +m[2] - 1, +m[3], 12), adaJam: !!m[4] };
  return null;
}
function pfParseStruk(teks) {
  if (!teks || teks.length < 15) return null;
  const baris = spBaris(teks);
  const nilaiDi = i => {
    const sama = baris[i].match(/-?\s*Rp\.?\s?[\d.,]+/i) || baris[i].match(/[\d]{1,3}(?:[.,]\d{3})+/);
    if (sama) return spAngka(sama[0].replace(/^Rp\.?/i, ''));
    for (let k = i + 1; k <= Math.min(baris.length - 1, i + 3); k++) { const m = baris[k].match(/-?\s*Rp\.?\s?[\d.,]+|^[\d]{1,3}(?:[.,]\d{3})+/i); if (m) return spAngka(m[0].replace(/^-?\s*Rp\.?/i, '')); }
    return 0;
  };
  let jumlah = 0;
