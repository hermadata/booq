<script>
/* =====================================================================================
   1. BERANDA (Dashboard Ringkasan)
   ===================================================================================== */
function pfBarBaris(nama, nilai, maks, kelas, total, judul) {
  return `<div class="fin2-bar-baris${total ? ' total' : ''}">
      <span class="fin2-bar-nama" title="${escapeHtml(judul || nama)}">${escapeHtml(nama)}</span>
      <span class="fin2-bar-rel"><span class="fin2-bar-isi ${kelas || ''}" style="width:${Math.min(100, Math.abs(nilai) / Math.max(1, maks) * 100).toFixed(1)}%"></span></span>
