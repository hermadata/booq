    --fin-hijau: #34d399; --fin-merah: #f87171; --fin-amber: #fbbf24; --fin-slate-5: #94a3b8; --fin-lembut: rgba(255,255,255,0.04); }
  .fin2 .fin2-kepala { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .fin2 .fin2-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fin-slate-5); }
  .fin2 .fin2-judul { margin: 2px 0 0; font-size: 22px; font-weight: 700; color: var(--web-text); letter-spacing: -0.01em; }
  .fin2 .fin2-kepala-aksi { display: flex; align-items: center; gap: 10px; }
  .fin2 .fin2-waktu { font-size: 11.5px; color: var(--fin-slate-5); }
  .fin2 .fin2-btn-kecil { font-size: 12px; padding: 7px 14px; }
  .fin2 .fin2-periode { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 16px; }
