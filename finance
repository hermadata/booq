    <button type="button" class="web-btn-secondary fin2-btn-kecil" onclick="pfJrFilter()">Cari</button></div>`;
  if (st.error && !d) return h + `<div class="fin2-pesan warn">⚠️ <div>Gagal memuat jurnal: ${escapeHtml(st.error)} <button type="button" class="fin2-link" onclick="pfJrCobaLagi('jurnal')">Coba lagi</button></div></div>`;
