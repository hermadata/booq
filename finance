function pfRenderLaporan() {
  const L = pf.lap, wadah = el('pf-lap-isi');
  if (!L || !wadah) return;
  const t = pf.tabLap;
  if (t === 'jurnal' || t === 'buku') pfMuatJurnal(t);
  let isi;
  if (t === 'jurnal') isi = pfHtmlJurnal(L);
  else if (t === 'buku') isi = pfHtmlBukuBesar(L);
  else if (t === 'ns') isi = pfHtmlNeracaSaldo(L);
  else if (t === 'surplus') isi = pfHtmlSurplus(L);
  else if (t === 'arus') isi = pfHtmlArus(L);
  else if (t === 'kekayaan') isi = pfHtmlKekayaan(L);
  else isi = pfHtmlNeraca(L);
  const fokus = document.activeElement && ['pf-jr-cari', 'pf-bb-cari'].includes(document.activeElement.id) ? document.activeElement.id : '';
  const nilai = fokus ? document.activeElement.value : null;
  wadah.innerHTML = isi;
  if (fokus && el(fokus)) { el(fokus).value = nilai; el(fokus).focus(); }
}

