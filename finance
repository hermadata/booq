  h += `<div class="fin2-gulir"><table class="fin2-tbl fin2-tbl-jurnal"><thead><tr><th>Tanggal</th><th>No. Bukti</th><th>Akun &amp; Keterangan</th><th class="n">Debet</th><th class="n">Kredit</th></tr></thead><tbody>`;
  d.entri.forEach(e => {
