<script>
/* =====================================================================================
   OmniAI Personal — Frontend
   Mesin UI diangkat dari Finance v2 OmniAI (fin2*, fmk*, sp*), disesuaikan untuk keuangan pribadi.
   ===================================================================================== */

// Isi HANYA kalau file ini di-hosting di luar Apps Script (GitHub Pages dll). Kalau dibuka dari URL
// web app Apps Script, biarkan kosong - koneksi memakai google.script.run (lebih aman, tanpa PIN).
const WEB_APP_URL = '';

const el = id => document.getElementById(id);
function escapeHtml(str) {
  return String(str === null || str === undefined ? '' : str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function pgrAttr(s) { return escapeHtml(String(s || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'")); }
function pgrToast(pesan) {
  let t = el('pgr-toast');
  if (!t) { t = document.createElement('div'); t.id = 'pgr-toast'; t.setAttribute('role', 'status'); document.body.appendChild(t); }
  t.textContent = pesan;
  t.classList.add('tampil');
  clearTimeout(pgrToast._timer);
  pgrToast._timer = setTimeout(() => t.classList.remove('tampil'), 2600);
}
function krTgl(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
function krParse(t) { const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(t || ''); return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null; }

/* ---------- Format angka (sama dengan OmniAI) ---------- */
function fin2Rp(n, opsi) {
  const v = Math.round(Number(n) || 0);
  const teks = 'Rp ' + Math.abs(v).toLocaleString('id-ID');
  if (v < 0) return (opsi && opsi.kurung) ? '(' + teks + ')' : '−' + teks;
  return teks;
}
function fin2RpSingkat(n) {
  const v = Number(n) || 0, a = Math.abs(v), t = v < 0 ? '−' : '';
  if (a >= 1e9) return t + (a / 1e9).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + ' M';
  if (a >= 1e6) return t + (a / 1e6).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + ' jt';
  if (a >= 1e3) return t + Math.round(a / 1e3).toLocaleString('id-ID') + ' rb';
  return t + Math.round(a).toLocaleString('id-ID');
}
function fin2Persen(x) { return ((Number(x) || 0) * 100).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + '%'; }
function fin2AngkaDariInput(inp) {
  if (!inp) return 0;
  const neg = /^\s*[-−]/.test(inp.value);
  const v = parseInt(String(inp.value || '').replace(/\D/g, ''), 10) || 0;
  return neg ? -v : v;
}
function fin2FormatInputRp(inp, bolehMinus) {
  const neg = bolehMinus && /^\s*[-−]/.test(inp.value);
  const digit = String(inp.value || '').replace(/\D/g, '').replace(/^0+(?=\d)/, '').slice(0, 13);
  inp.value = (neg ? '-' : '') + (digit ? Number(digit).toLocaleString('id-ID') : '');
}
function fin2SetRp(inp, n) { inp.value = n ? Math.round(n).toLocaleString('id-ID') : ''; }
const PF_BULAN_PANJANG = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
function fin2TglLabel(s) { const d = krParse(s); return d ? d.getDate() + ' ' + PF_BULAN_PANJANG[d.getMonth()] + ' ' + d.getFullYear() : (s || ''); }
function fin2TglPendek(t) { const d = krParse(t); return d ? String(d.getDate()).padStart(2, '0') + ' ' + ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'][d.getMonth()] + ' ' + String(d.getFullYear()).slice(2) : t; }
function fin2Ang(n) { const v = Math.round(Number(n) || 0); return v ? (v < 0 ? '(' + Math.abs(v).toLocaleString('id-ID') + ')' : v.toLocaleString('id-ID')) : '–'; }

/* =====================================================================================
   STATE
   ===================================================================================== */
const pf = {
  akun: [], A: {}, golongan: {}, grupBeban: [], aturan: [], setelan: {}, saldoAwal: {}, saldoKini: {}, hariIni: '',
  lap: null, lapKunci: '', seqLap: 0, preset: 'bulan', dari: '', sampai: '',
  view: '', tabLap: 'neraca', siap: false,
  jr: { hal: 1, jenis: '', cari: '', data: null, kunci: '', seq: 0 },
  bb: { akun: '*beban', hal: 1, cari: '', data: null, kunci: '', seq: 0 },
  mt: { status: 'belum', bulan: '', akun: '', cari: '', hal: 1, data: null, seq: 0 },
  ct: { tipe: 'keluar', kat: '', hal: 1, data: null, seq: 0 },
  sp: { sumber: '', nama: '', baris: [] }
};
const PF_NERACA = ['kas', 'piutang', 'investasi', 'tetap', 'utangPendek', 'utangPanjang'];

/* =====================================================================================
   KONEKSI KE BACKEND (google.script.run / fetch + PIN) + loading bar
   ===================================================================================== */
let pfMuatN = 0, pfBarTimer = null;
function pfBarMulai() {
  const b = el('web-loading-bar');
  if (pfMuatN++ === 0 && b) {
    b.classList.add('active'); b.style.transition = 'none'; b.style.width = '0%';
    requestAnimationFrame(() => { b.style.transition = 'width 8s cubic-bezier(.1,.7,.2,1), opacity .2s'; b.style.width = '85%'; });
  }
}
function pfBarSelesai() {
  const b = el('web-loading-bar');
  if (--pfMuatN <= 0 && b) {
    pfMuatN = 0; b.style.transition = 'width .2s ease, opacity .3s ease .2s'; b.style.width = '100%';
    clearTimeout(pfBarTimer); pfBarTimer = setTimeout(() => { b.classList.remove('active'); b.style.width = '0%'; }, 450);
  }
}
function pfPin() { try { return localStorage.getItem('pf_pin') || ''; } catch (e) { return ''; } }
function pfKirim_(body) {
  return new Promise((resolve, reject) => {
    if (window.google && google.script && google.script.run) {
      google.script.run
        .withSuccessHandler(s => { try { resolve(typeof s === 'string' ? JSON.parse(s) : s); } catch (e) { reject(e); } })
        .withFailureHandler(err => reject(new Error((err && err.message) || String(err))))
        .pfApi(JSON.stringify(body));
    } else if (WEB_APP_URL) {
      fetch(WEB_APP_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(Object.assign({ pin: pfPin() }, body)) })
        .then(r => r.json()).then(resolve, reject);
    } else {
      reject(new Error('Backend belum terhubung. Buka aplikasi dari URL Web App Apps Script, atau isi WEB_APP_URL.'));
    }
  });
}
async function api(body, opsi) {
  opsi = opsi || {};
  if (!opsi.senyap) pfBarMulai();
  try {
    let d = await pfKirim_(body);
    if (d && d.success === false && d.kode === 'PIN') {
      const pin = prompt(d.error + '\nMasukkan PIN aplikasi:');
      if (pin) { try { localStorage.setItem('pf_pin', pin); } catch (e) { } d = await pfKirim_(body); }
    }
    if (!d || d.success === false) throw new Error((d && d.error) || 'Gagal menghubungi server');
    return d;
  } finally { if (!opsi.senyap) pfBarSelesai(); }
}

/* ---------- Cache snapshot (localStorage) - tampil instan saat dibuka, diperbarui di latar ---------- */
const PF_SNAP = 'pf_snap_v1';
function snapBaca(k) { try { const o = JSON.parse(localStorage.getItem(PF_SNAP) || '{}'); return o[k] ? o[k].d : null; } catch (e) { return null; } }
function snapSimpan(k, d) {
  try {
    const o = JSON.parse(localStorage.getItem(PF_SNAP) || '{}');
    o[k] = { t: Date.now(), d };
    const kunci = Object.keys(o).sort((a, b) => o[b].t - o[a].t);
    kunci.slice(10).forEach(x => delete o[x]);
    localStorage.setItem(PF_SNAP, JSON.stringify(o));
  } catch (e) { try { localStorage.removeItem(PF_SNAP); } catch (x) { } }
}
function dataSegarSet(memuat, gagal) {
  const s = el('pf-segar');
  if (!s) return;
  s.className = 'data-segar' + (memuat ? ' memuat' : gagal ? ' gagal' : '');
  s.innerHTML = memuat ? '<i class="dok-spin"></i> <span>Memperbarui…</span>' : gagal ? '⚠️ Gagal memperbarui' : '<span class="titik"></span>Data terkini';
}

/* =====================================================================================
