/* ===== JURNAL UMUM & BUKU BESAR (dimuat terpisah, berhalaman) ===== */
async function pfMuatJurnal(mode) {
  const st = mode === 'buku' ? pf.bb : pf.jr;
  const kunci = [mode, pf.dari, pf.sampai, st.hal, mode === 'buku' ? st.akun + '|' + st.cari : st.jenis + '|' + st.cari, pf.lap && pf.lap.info ? pf.lap.info.dibuat : 0].join('|');
  if (st.kunci === kunci && st.data) return;
  if (st.kunciGagal === kunci || (st.memuat && st.kunciMemuat === kunci)) return;
  const seq = ++st.seq;
  st.memuat = true; st.kunciMemuat = kunci;
  if (st.data) pfRenderLaporan();
  try {
    const body = { aksi: mode, dari: pf.dari, sampai: pf.sampai, hal: st.hal, cari: st.cari };
    if (mode === 'buku') body.akun = st.akun; else body.jenis = st.jenis;
    const r = await api(body);
    if (seq !== st.seq) return;
    st.data = r; st.kunci = kunci; st.error = ''; st.kunciGagal = '';
    if (mode === 'buku' && r.akun) st.akun = r.akun.kode;
  } catch (err) {
    if (seq !== st.seq) return;
    st.error = err.message; st.kunciGagal = kunci;
  } finally {
    if (seq === st.seq) { st.memuat = false; if (pf.tabLap === mode && pf.view === 'laporan') pfRenderLaporan(); }
  }
}
function pfJrCobaLagi(mode) { const st = mode === 'buku' ? pf.bb : pf.jr; st.kunciGagal = ''; st.error = ''; pfRenderLaporan(); }
function pfJrHal(h) { pf.jr.hal = h; pfRenderLaporan(); }
function pfBbHal(h) { pf.bb.hal = h; pfRenderLaporan(); }
